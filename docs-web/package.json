{
  "name": "novagraph-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run docs:check && tsc -b && vite build",
    "preview": "vite preview",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "test": "node --test tests/*.test.mjs scripts/test-resource-results.mjs",
    "docs:examples": "make -C .. cpp-build c-header-check && python3 ../tools/test-doc-examples.py",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@types/marked": "^5.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
}
